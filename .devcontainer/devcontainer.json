{
  "name": "${containerWorkspaceFolder}-python",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",

  "runArgs": [
    "--name=${containerWorkspaceFolder}-python-dev",
    "--add-host=host.docker.internal:host-gateway"
  ],

  "containerEnv": {
    "LMSTUDIO_BASE_URL": "http://host.docker.internal:1234/v1"
  },

  "remoteUser": "vscode",

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "mounts": [
    "source=${localWorkspaceFolderBasename}-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=${localWorkspaceFolderBasename}-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  "postCreateCommand": "sudo mkdir -p /home/vscode/.cache/uv ${containerWorkspaceFolder}/.venv && sudo chown -R vscode:vscode /home/vscode/.cache/uv ${containerWorkspaceFolder}/.venv && curl -LsSf https://astral.sh/uv/install.sh | sh && export PATH=$HOME/.local/bin:$PATH && uv venv && uv sync --link-mode=copy",
  "forwardPorts": [8000],

  "portsAttributes": {
    "8000": {
      "label": "FastAPI server",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [],

      "settings": {
        "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
